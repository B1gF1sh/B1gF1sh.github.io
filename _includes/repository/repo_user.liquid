<div class="repo-user">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener">
    <img
      alt="{{ include.username }}"
      src="https://github.com/{{ include.username }}.png?size=96"
      class="repo-user__avatar"
      onerror="this.style.display='none'"
    >
  </a>

  <div class="repo-user__info">
    <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener" class="repo-user__name">
      {{ include.username }}
    </a>
  </div>
</div>