{% assign full = include.repository %}
{% assign name = full | split: '/' | last %}

<div class="repo-card">
  <a class="repo-card__title" href="https://github.com/{{ full }}" target="_blank" rel="noopener">
    {{ name }}
  </a>

  <div class="repo-card__subtitle">
    <span class="repo-card__owner">{{ full | split: '/' | first }}</span>
  </div>

  <div class="repo-card__badges">
    <img alt="Stars"
         src="https://img.shields.io/github/stars/{{ full }}?style=flat-square&label=%E2%98%85"
         onerror="this.style.display='none'">
    <img alt="Language"
         src="https://img.shields.io/github/languages/top/{{ full }}?style=flat-square&label=lang"
         onerror="this.style.display='none'">
    <img alt="Last commit"
         src="https://img.shields.io/github/last-commit/{{ full }}?style=flat-square&label=updated"
         onerror="this.style.display='none'">
  </div>
</div>